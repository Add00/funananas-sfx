{
    "name": "@funananas/sfx",
    "version": "2026.11.07",
    "description": "FunAnanas's sound engine: games and tools bring sounds as plain-data scores, and it plays them, or renders them to samples, with Web Audio.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "main": "./src/sfx.js",
    "types": "./src/sfx.d.ts",
    "exports": {
        ".": {
            "types": "./src/sfx.d.ts",
            "default": "./src/sfx.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "src",
        "docs"
    ],
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    }
}
